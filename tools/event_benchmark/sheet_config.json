{
  "_comment": "Running results Google Sheet for the event-recognition benchmark. Consumed by the bench-sheet-push skill. Non-secret: only the spreadsheet id + layout live here. Auth is the in-session Google OAuth connector (no keys stored). Layout is PIVOTED and has NO tracking columns: one row per model, dataset size as a top band (50 / 100 / all 120). Each dataset block repeats Overall + the 4 subtasks; speed, cost and meta are single per-model columns. Price = each run's cost: OpenRouter token price ($/Mtok) for API models, computed GPU run cost ($) for self-hosted models.",
  "spreadsheet_id": "1D3-fwFW5Fv1ASDlbt3VUIFJJfAKKsrH2LXVNMkoPLjA",
  "spreadsheet_url": "https://docs.google.com/spreadsheets/d/1D3-fwFW5Fv1ASDlbt3VUIFJJfAKKsrH2LXVNMkoPLjA/edit",
  "tab": "results",
  "sheet_id": 0,
  "header_rows": 2,
  "upsert_keys": ["model"],
  "datasets": [
    {"id": "50",  "label": "DATASET · 50",      "cols": {"overall": "E", "fight": "F", "smoking": "G", "fall": "H", "weapon": "I"}},
    {"id": "100", "label": "DATASET · 100",     "cols": {"overall": "J", "fight": "K", "smoking": "L", "fall": "M", "weapon": "N"}},
    {"id": "120", "label": "DATASET · all 120", "cols": {"overall": "O", "fight": "P", "smoking": "Q", "fall": "R", "weapon": "S"}}
