# Private recordings are excluded; intentional packaged UI images are allowed.
# All local-state and credential exclusions below take priority over this list.
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv
**/*.webm
**/*.jpg
**/*.jpeg
**/*.png
**/*.webp
**/*.heic
!src/goodvision_harness/assets/**/*.jpg
!src/goodvision_harness/assets/**/*.jpeg
!src/goodvision_harness/assets/**/*.png
!src/goodvision_harness/assets/**/*.webp

# Repository metadata and local development files are not build inputs.
.git
.gitignore
.agents
.codex
.github
.audit*
.worktrees
docs
tests
personal
**/.DS_Store
**/._*
**/Thumbs.db
**/Desktop.ini
**/*.swp
**/*.swo
**/*~

# Exclude every local environment/credential variant, including nested files.
**/.env
**/.env.*
**/.ssh
**/*.pem
**/*.key

# Python environments, caches, test results, and build products.
**/.venv*
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.hypothesis
**/.tox
**/.nox
**/.cache
**/.coverage*
**/coverage.xml
**/htmlcov
**/build
**/dist
**/*.whl

# Models are mounted/downloaded separately; private runtime state stays local.
**/.models
**/.goodvision
**/memory
models
checkpoints
data
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
**/*.ckpt
**/*.pdparams
**/*.pdiparams

# Generated evaluation runs, delivery exports, and logs.
**/logs
**/output
**/outputs
**/tmp
artifacts
media
**/*.log
**/*.tar
**/*.tar.gz
**/*.tgz
**/goodvision-*.tar.partial
**/*.zip
