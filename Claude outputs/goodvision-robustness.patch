+@dataclass(frozen=True, slots=True)
+class BranchCadence:
+    """Sampling rate and window shape for one independently scheduled branch."""
+
+    fps: float
+    size_frames: int = 1
+    stride_frames: int = 1
+
+    def __post_init__(self) -> None:
