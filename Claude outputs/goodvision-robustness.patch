+      diagCell(diagSeconds(b.longest_unanalyzed_gap_seconds)+(b.gap_scope==="recent"?"（最近 "+b.gap_history_size+" 次）":""),gapWarn),
+      diagCell(diagSeconds(b.current_unanalyzed_gap_seconds),currentWarn),
+      diagCell((b.succeeded||0)+" / "+failed+" / "+(b.dropped||0),failed?"diag-bad":(b.dropped?"diag-warn":"")),
+      diagCell(diagFailureText(b.failures),failed?"diag-bad":""),
