+  }else{failureNote.className="note";failureNote.textContent=""}
+  renderDiagnosticInputs(data.model_inputs||[]);
+}
+function renderDiagnosticInputs(inputs){
+  const box=$("diag-inputs");
+  const key=inputs.map(entry=>entry.id+":"+entry.outcome).join(",");
+  if(key===diagState.inputKey)return;
+  diagState.inputKey=key;box.replaceChildren();
+  if(!inputs.length){const empty=document.createElement("span");empty.className="diag-empty";empty.textContent="暂无";box.appendChild(empty);return}
+  for(const entry of inputs){
+    const card=document.createElement("div");card.className="diag-input";
+    const strip=document.createElement("div");strip.className="diag-strip";
+    (entry.frames||[]).forEach((frame,index)=>{
+      const img=document.createElement("img");img.loading="lazy";img.alt="model input "+entry.id+" frame "+index;
+      img.onerror=()=>{const gone=document.createElement("span");gone.className="diag-empty";gone.textContent="图片已过期";img.replaceWith(gone)};img.src="/v1/diagnostics/model-inputs/"+encodeURIComponent(entry.id)+"/frames/"+index+".jpg";strip.appendChild(img)
+    });
+    const frames=entry.frames||[],newest=frames[frames.length-1]||{};
+    const title=document.createElement("div");
+    const label=document.createElement("b");label.textContent=(diagBranchNames[entry.role]||entry.role)+" #"+entry.id;title.appendChild(label);
+    const outcome=document.createElement("span");
+    const ok=entry.outcome==="ok",pending=entry.outcome==="pending";
+    outcome.className=ok||pending?"":"diag-bad";
