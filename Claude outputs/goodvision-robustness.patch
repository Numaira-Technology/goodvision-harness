+    title.appendChild(outcome);
+    const meta=document.createElement("div");
+    meta.textContent=(newest.width||"?")+"×"+(newest.height||"?")+" · "+Math.round((newest.bytes||0)/1024*10)/10+" KB · "+frames.length+" 帧 · 源 "+
+      (entry.source_width||"?")+"×"+(entry.source_height||"?")+" · 源帧 "+diagSeconds(newest.timestamp_seconds)+
+      (entry.model_latency_seconds!==undefined?" · 耗时 "+diagSeconds(entry.model_latency_seconds):"");
+    card.append(strip,title,meta);box.appendChild(card)
+  }
+}
+async function diagnostics(){
+  try{
+    const response=await fetch("/v1/diagnostics",{cache:"no-store"});
+    if(!response.ok)throw new Error("HTTP "+response.status);
+    renderDiagnostics(await response.json())
+  }catch(error){setChannel($("diag-state"),"Diagnostics · unavailable","warn")}
+}
 mode("stream");info().finally(loadDeploymentSettings);status().finally(connectResultEvents);setInterval(status,2000);
