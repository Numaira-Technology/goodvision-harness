{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodvision.local/schemas/event-v1.schema.json",
  "title": "GoodVision event episode and immutable evidence revision",
  "type": "object",
  "required": ["type", "schema_version", "event_id", "revision", "stream_session_id", "source_id", "subject_id", "subject_ids", "subject_type", "event_label", "state", "status", "finalized", "start_seconds", "last_detected_seconds", "end_seconds", "end_reason", "started_at", "created_at", "updated_at", "observation_count", "confidence", "description", "identity_state", "person_id", "person_name", "evidence"],
  "properties": {
    "type": {"const": "event"},
    "schema_version": {"const": "1"},
    "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{32}$"},
    "revision": {"type": "integer", "minimum": 1},
    "stream_session_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string"},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "subject_type": {"enum": ["person", "group", "target", "scene", "unassociated"]},
    "event_label": {"type": "string", "minLength": 1},
    "state": {"enum": ["active", "ended"]},
    "status": {"enum": ["active", "ended"]},
    "finalized": {"type": "boolean"},
    "start_seconds": {"type": "number", "minimum": 0},
    "last_detected_seconds": {"type": "number", "minimum": 0},
    "end_seconds": {"type": ["number", "null"], "minimum": 0},
    "end_reason": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "observation_count": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "description": {"type": "string"},
    "identity_state": {"type": "string"},
    "person_id": {"type": ["string", "null"]},
    "person_name": {"type": ["string", "null"]},
    "requested_event_id": {"type": "string"},
    "canonical_event_id": {"type": "string"},
    "evidence": {
      "type": "object",
      "required": ["revision", "status", "requested_window", "available"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["collecting", "queued", "encoding", "ready", "failed", "expired"]},
        "requested_window": {
          "type": "object",
          "required": ["start_seconds", "end_seconds"],
          "properties": {"start_seconds": {"type": "number"}, "end_seconds": {"type": "number", "minimum": 0}},
          "additionalProperties": false
        },
        "failure_reason": {"type": ["string", "null"]},
        "available": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["revision", "url", "duration_seconds", "fps", "partial"],
              "properties": {
                "revision": {"type": "integer", "minimum": 1},
                "url": {"type": "string", "pattern": "^/v1/events/event-[0-9a-f]{32}/video\\?revision=[1-9][0-9]*$"},
                "start_seconds": {"type": "number", "minimum": 0},
                "end_seconds": {"type": "number", "minimum": 0},
                "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
                "fps": {"type": "number", "exclusiveMinimum": 0},
                "frame_count": {"type": "integer", "minimum": 1},
                "width": {"type": "integer", "minimum": 2},
                "height": {"type": "integer", "minimum": 2},
                "byte_length": {"type": "integer", "minimum": 1},
                "mime_type": {"const": "video/mp4"},
                "partial": {"type": "boolean"},
                "partial_reason": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
