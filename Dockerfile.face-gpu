FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HARNESS_CONFIG=/app/config.yaml \
    HARNESS_DEPLOYMENT_SETTINGS_PATH=/data/deployment-settings.json \
    HARNESS_STREAM_URL=webrtc+http://192.168.20.199:1985/rtc/v1/whep/?app=live&stream=livestream \
    HARNESS_DRY_RUN=true \
    HARNESS_AUTOSTART=true \
    HARNESS_HOST=0.0.0.0 \
    HARNESS_PORT=8080 \
    FACE_PROVIDER=CUDAExecutionProvider

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        ffmpeg \
        libgl1 \
        libgomp1 \
        libglib2.0-0 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
# ORT 1.26 is the final CUDA 12.8/cuDNN 9 PyPI line before the default wheel
# changes to CUDA 13. The cuda/cudnn extras vendor user-space libraries; the
# NVIDIA container runtime injects the host driver on the RTX 5090 server.
RUN python -m pip install --no-cache-dir --timeout 120 --retries 5 '.[face-gpu,webrtc]'

# InsightFace's distribution metadata names CPU ORT and GUI OpenCV even for
# server/GPU usage. They overwrite the same Python modules as our variants.
# Remove both copies before reinstalling exactly one provider of each module.
# Keep upstream metadata intact and audit its two known name-only exceptions.
COPY tools/face_gpu_smoke.py ./tools/face_gpu_smoke.py
RUN python -m pip uninstall -y onnxruntime onnxruntime-gpu opencv-python opencv-python-headless \
    && python -m pip install --no-cache-dir --timeout 120 --retries 5 --no-deps \
        onnxruntime-gpu==1.26.0 opencv-python-headless==4.14.0.94 \
    && python tools/face_gpu_smoke.py --runtime

COPY config.yaml ./config.yaml

RUN groupadd --system --gid 10001 harness \
    && useradd --system --uid 10001 --gid harness --home-dir /nonexistent harness \
    && mkdir -p /models /data \
    && chown -R harness:harness /app /models /data

USER 10001:10001

EXPOSE 8080
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=15s --timeout=3s --start-period=120s --retries=4 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=2).read()"]

CMD ["goodvision-harness"]

# The customer target is built from source and this Dockerfile's dependencies;
# no previously exported product image is required on a clean checkout.
FROM runtime AS customer
USER root
WORKDIR /app
# Only redundant product-development files are removed from the runtime view.
# Installed dependencies, their metadata and original notices stay intact.
RUN rm -rf /app/src \
    && rm -f /app/pyproject.toml /app/tools/face_gpu_smoke.py
COPY config.delivery.yaml ./config.yaml
COPY config.delivery.yaml /usr/local/lib/python3.11/site-packages/goodvision_harness/config.yaml
COPY tools/runtime_gateway.py /opt/goodvision/runtime_gateway.py
COPY src/goodvision_harness/privacy.py /opt/goodvision/public_privacy.py
COPY tools/face_gpu_smoke.py /opt/goodvision/internal/face_check.py
COPY tools/customer_check.py ./tools/check_runtime.py
COPY tools/customer_check.py ./tools/check_face.py
ENV GOODVISION_COMPONENT=main \
    HARNESS_INFERENCE_PROFILE=customer-standard \
    FACE_ACCELERATOR=gpu \
    FACE_PROVIDER=""
RUN python /opt/goodvision/internal/face_check.py --runtime \
    && chown -R 10001:10001 /app /opt/goodvision
USER 10001:10001
ENTRYPOINT []
CMD ["python", "/opt/goodvision/runtime_gateway.py", "serve"]

# Preserve the original development image as the implicit build target.
FROM runtime AS development
