# Full GPU deployment: the main and perception services start by default.
# Keep an existing .env and the goodvision-harness project/volumes when upgrading.
# Copy this example only for a new installation; never overwrite saved secrets.

# Use 0.0.0.0 only on a protected management/robot LAN.
# Use 127.0.0.1 with an SSH tunnel or a host-local reverse proxy.
HARNESS_BIND_ADDRESS=0.0.0.0
HARNESS_PORT=8080
HARNESS_SOURCE_ID=external-camera

# The full Compose entry fixes FACE_ACCELERATOR=gpu,
# RICH_LABEL_ENABLED=true and the internal perception endpoint. Old values for
# these settings in an existing .env cannot silently disable full GPU mode.
FACE_LIVE_SCHEDULER=auto

# Both services use one available GPU, exposed as gpu:0 inside the worker.
RICH_DETECTOR_PROFILE=accurate
RICH_ATTRIBUTE_PROFILE=standard
RICH_DETECTION_THRESHOLD=0.45
RICH_TRACK_VISIBLE_IDLE_FRAMES=1
RICH_ATTRIBUTE_INTERVAL_FRAMES=10
RICH_ATTRIBUTE_RETRY_SECONDS=60
RICH_ATTRIBUTE_SHUTDOWN_TIMEOUT_SECONDS=5

# Optional model directories inside the persistent rich-models volume (/models).
# Leave empty to use the selected model profile's cache. GPU image packages do
# not themselves establish that the model weights are present or licensed.
RICH_DETECTOR_MODEL_DIR=
RICH_ATTRIBUTE_MODEL_DIR=

# Optional video-source override. The image defaults to the robot LAN WHEP source:
# HARNESS_STREAM_URL=webrtc+http://192.168.20.199:1985/rtc/v1/whep/?app=live&stream=livestream

# The deployment console saves stream URL, test/live mode, autostart and API Key.
# Existing persisted settings remain authoritative; a new installation starts
# in test mode until configured. Do not put customer keys in the delivery pack.
# The customer image uses a fixed service preset. Previous route/model/endpoint
# overrides do not change it. Credentials saved for another service are kept
# separate; if needed, save the correct preset credential in the same console.
# INFERENCE_API_KEY is an optional credential for this preset only.
INFERENCE_API_KEY=
VIDEO_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000
RESULT_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=
