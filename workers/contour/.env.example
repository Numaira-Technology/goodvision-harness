# Local console first; set a private network IP for access from another host.
CONTOUR_BIND_ADDRESS=127.0.0.1
CONTOUR_PORT=8093
CONTOUR_GPU_ID=0
# Independent video sessions sharing one warmed model; set 2 for two cameras.
CONTOUR_CAPACITY=1
# Cache the exact person prompt and release its text encoder after warmup.
# Validated with the pinned checkpoint; set false for an uncached A/B baseline.
CONTOUR_FIXED_PERSON_TEXT=true
# Log allocated/reserved memory separately alongside per-request stage timings.
CONTOUR_GPU_DIAGNOSTICS=false
# Host directory containing contour.pt; shared by the console and GPU runtime.
CONTOUR_MODELS_DIR=./models
CONTOUR_TORCH_CUDA=cu128
