# Build with the repository root as context. Keep the verified GPU runtime.
ARG RUNTIME_BASE=goodvision-rich-label-worker:2026.09.02-full-gpu-cu129.1
FROM ${RUNTIME_BASE} AS customer-runtime
USER root
WORKDIR /worker
COPY workers/paddle_rich_label/app.py ./app.py
RUN rm -f /worker/requirements.txt /worker/gpu_smoke.py
COPY tools/runtime_gateway.py /opt/goodvision/runtime_gateway.py
COPY src/goodvision_harness/privacy.py /opt/goodvision/public_privacy.py
COPY tools/perception_runtime_check.py /opt/goodvision/internal/runtime_check.py
COPY workers/paddle_rich_label/gpu_smoke.py /opt/goodvision/internal/perception_check.py
COPY tools/customer_checks/check_runtime.py ./tools/check_runtime.py
COPY tools/customer_checks/check_perception.py ./tools/check_perception.py
ENV GOODVISION_COMPONENT=perception \
    PYTHONPATH=/worker \
    RICH_DETECTOR_PROFILE=accurate \
    RICH_ATTRIBUTE_PROFILE=standard \
    RICH_DETECTOR_MODEL="" \
    RICH_ATTRIBUTE_MODEL="" \
    MPLCONFIGDIR=/tmp/plotting
RUN python /opt/goodvision/internal/runtime_check.py \
    && chown -R 10002:10002 /worker /opt/goodvision
USER 10002:10002
ENTRYPOINT []
CMD ["python", "/opt/goodvision/runtime_gateway.py", "serve"]
