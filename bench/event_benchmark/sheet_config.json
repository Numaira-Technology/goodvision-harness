{
  "_comment": "Running results Google Sheet for the event-recognition benchmark. Consumed by the bench-sheet-push skill. Non-secret: only the spreadsheet id + layout live here. Auth is the in-session Google OAuth connector (no keys stored). Layout is PIVOTED: one row per model, with dataset size as a top band (50 / 100 / all 120). Each dataset block repeats Overall + the 4 subtasks; speed, cost, tracking and meta are single per-model columns.",
  "spreadsheet_id": "1D3-fwFW5Fv1ASDlbt3VUIFJJfAKKsrH2LXVNMkoPLjA",
  "spreadsheet_url": "https://docs.google.com/spreadsheets/d/1D3-fwFW5Fv1ASDlbt3VUIFJJfAKKsrH2LXVNMkoPLjA/edit",
  "tab": "results",
  "sheet_id": 0,
  "header_rows": 2,
  "upsert_keys": ["model"],
  "datasets": [
    {"id": "50",  "label": "DATASET · 50",      "cols": {"overall": "G", "fight": "H", "smoking": "I", "fall": "J", "weapon": "K"}},
    {"id": "100", "label": "DATASET · 100",     "cols": {"overall": "L", "fight": "M", "smoking": "N", "fall": "O", "weapon": "P"}},
    {"id": "120", "label": "DATASET · all 120", "cols": {"overall": "Q", "fight": "R", "smoking": "S", "fall": "T", "weapon": "U"}}
