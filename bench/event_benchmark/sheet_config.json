  "color_scales": {
    "_note": "Muted warm scheme (low contrast); green is reserved for best-only. Per-column independent gradient (one rule per column) on data rows (row 3+); blank cells uncolored. Palette: red #E67C73, orange #F9CB9C, pale #FCE5CD, green #B6D7A8, yellow #FFE599.",
    "mode": "per_column_relative",
    "accuracy": "Every Overall + subtask column (G..U, all three dataset blocks) gets its own gradient red(min) -> orange(max); PLUS one boolean rule over G:U: value == 100 -> green (overrides the gradient, so green appears ONLY at a perfect 100.0).",
    "lower_better": "E,F (latency) and W (price)  gradient pale(min) -> red(max); no green.",
    "status": {
      "_note": "Text cells with single-color rules, not gradients.",
      "run": "C  yes -> green · running -> yellow · no -> red",
      "validation": "D  yes -> green (decision + clip models) · no -> red (language models)"
    }
