    {"col": "O", "key": "d100_fall",      "header": "Fall %",         "type": "num", "scale": "higher_better", "dataset": "100", "note_key": "d100_fall_note"},
    {"col": "P", "key": "d100_weapon",    "header": "Weapon %",       "type": "num", "scale": "higher_better", "dataset": "100", "note_key": "d100_weapon_note"},
    {"col": "Q", "key": "d120_overall",   "header": "Overall %",      "type": "num", "scale": "higher_better", "dataset": "120"},
