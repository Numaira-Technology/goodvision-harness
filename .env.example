# Robot LAN WHEP source. Settings saved in the deployment console take precedence.
HARNESS_STREAM_URL=webrtc+http://192.168.20.199:1985/rtc/v1/whep/?app=live&stream=livestream

# Deprecated compatibility fallback for existing RTSP deployments.
RTSP_URL=

# Select aiclub (default), openrouter, or dashscope, then restart the process.
# Keep each route's key in this ignored .env so switching needs only one variable.
INFERENCE_PROVIDER=aiclub
AICLUB_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
# Optional overrides. Empty model/endpoint use the selected route's defaults.
# The endpoint must be the complete chat-completions URL.
INFERENCE_MODEL=
INFERENCE_ENDPOINT=
# Optional shared override; takes precedence over the selected route's env key.
# Leave empty when retaining separate credentials for different routes.
INFERENCE_API_KEY=
HARNESS_DRY_RUN=false
HARNESS_AUTOSTART=true
HARNESS_SOURCE_ID=external-camera
HARNESS_BIND_ADDRESS=127.0.0.1
HARNESS_PORT=8080

# Optional local face-analysis storage overrides. Keep both directories writable.
# This non-commercial demo config allows model download. Disable
# face.allow_model_download for any use not covered by the model license.
FACE_MODEL_ROOT=.models/face
FACE_GALLERY_PATH=.goodvision/face-gallery.json
# The base image is CPU-only. compose.face-gpu.yaml fixes this to CUDA.
FACE_PROVIDER=CPUExecutionProvider
# auto keeps CPU face work single-flight and runs accelerated face work at full cadence.
FACE_LIVE_SCHEDULER=auto

# Optional rich bounding boxes. Start the isolated CPU reference worker with
# `docker compose --profile rich up --build`, then set this to true.
RICH_LABEL_ENABLED=false
RICH_LABEL_ENDPOINT=http://rich-label-worker:8091/v1/labels
RICH_DEVICE=cpu
RICH_DETECTOR_MODEL=PicoDet-S
# Used only by compose.gpu.yaml; the CPU profile keeps RICH_DETECTOR_MODEL.
RICH_GPU_DETECTOR_MODEL=PP-YOLOE_plus-L
RICH_ATTRIBUTE_MODEL=PP-LCNet_x1_0_pedestrian_attribute
RICH_DETECTION_THRESHOLD=0.45
# Hold a track through one detector miss; set 0 to disable the debounce.
RICH_TRACK_VISIBLE_IDLE_FRAMES=1
RICH_ATTRIBUTE_RETRY_SECONDS=60

# Optional legacy RTSP fallback/troubleshooting setting; WHEP does not use it:
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000
# Set a different value only when an RTSP source requires it.

# Optional push delivery. Leave blank when the receiver consumes latest JSON
# or SSE from the harness directly.
RESULT_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=

# Optional background tracking and evidence overrides.
PERSON_TRACKING_ENABLED=true
# EVENT_EVIDENCE_DIRECTORY=/data/event-evidence
# EVENT_FFMPEG_PATH=ffmpeg

# Continuous people/events: disabled (default), shadow (observe only), or active.
# active requires a ready GPU tracker and valid temporal model credentials.
SCENE_ENGINE_MODE=disabled
# Legacy flag enables shadow mode when SCENE_ENGINE_MODE is disabled.
SCENE_ENGINE_ENABLED=false
SCENE_TIMEOUT_SECONDS=15
SCENE_MAX_IMAGE_SIDE=720
SCENE_MAX_TOKENS=1600
# For a remote SAM worker, also set RICH_LABEL_BACKEND=sam, RICH_LABEL_ENABLED=true,
# RICH_LABEL_ENDPOINT=http://<worker-host>:8092/v1/tracks,
# RICH_LABEL_TIMEOUT_SECONDS=20 and RICH_LABEL_MAX_FPS=4.
# compose.scene.yaml applies these automatically for its local GPU worker.
# SAM_SCENE_CHECKPOINT_FILE=./.models/sam3/sam3.pt
# Native SAM 3.1 video uses RICH_LABEL_BACKEND=sam31 and endpoint
# http://127.0.0.1:8092/v1/video/batches (through a private connection/SSH tunnel).
# In that mode model memory is scoped to each batch.
# Persistent experimental memory uses RICH_LABEL_BACKEND=sam31_stream, endpoint
# http://127.0.0.1:8092/v1/video/sessions and SAM31_SESSION_ENABLED=true on the worker.
# Start at RICH_LABEL_MAX_FPS=4, SAM31_BATCH_FRAMES=16; keep original evidence locally.
# SAM31_BATCH_FRAMES=16
# SAM31_BATCH_SECONDS=4
# SAM31_CLIENT_TIMEOUT_SECONDS=75
# SAM31_CHECKPOINT_FILE=./.models/sam3.1/sam3.1_multiplex.pt
# Independent processing methods in the deployment console. Add
# compose.perception.yaml after compose.yaml and compose.sam31.yaml.
# A saved console choice takes precedence over this initial default.
# PERCEPTION_METHOD=sam_live
# Values: sam_live (causal SAM), hybrid (light detector + asynchronous SAM).
# Requires SCENE_ENGINE_MODE=active and RICH_LABEL_BACKEND=sam31_stream.
# HYBRID_CHECKPOINT_FILE=./.models/ssdlite320_mobilenet_v3_large_coco-a79551df.pth

# Optional remote SAM: select compose.sam31-remote.yaml alongside compose.yaml.
# Keep event-model settings above. Ordinary/local-SAM Compose needs no rental keys.
# Use your team-scoped Vast key and register the matching SSH PUBLIC key in Vast.
# SAM_SSH_KEY is an absolute PRIVATE key path on the Docker host, not the key text.
# The controller mounts it read-only and uses it without an interactive prompt.
# HF_TOKEN must have approved download access to facebook/sam3.1.
# Only the controller receives rental credentials; SSH carries HF_TOKEN to the GPU
# for weight download. The Vast key and SSH private key stay on the Docker host.
VAST_API_KEY=
SAM_SSH_KEY=
HF_TOKEN=
# Vast GPU name, e.g. RTX_4090 or L40S. Only RTX_4090 has been validated.
SAM_GPU_NAME=RTX_4090
SAM_DISK_GB=50

# Optional named-volume overrides for the remote-SAM Compose overlay.
# Leave blank to use this Compose project's face-data and face-models volumes.
HARNESS_DATA_VOLUME=
HARNESS_MODELS_VOLUME=

