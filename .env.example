# Required. On 14.198.55.6, use the agreed camera RTSP URL. If an RTSP
# relay runs on that same host, this is the host-gateway form:
# RTSP_URL=rtsp://host.docker.internal:8554/live/livestream
RTSP_URL=

OPENROUTER_API_KEY=
HARNESS_DRY_RUN=false
HARNESS_AUTOSTART=true
HARNESS_SOURCE_ID=external-camera
HARNESS_BIND_ADDRESS=127.0.0.1
HARNESS_PORT=8080

# Optional local InsightFace storage overrides. Keep both directories writable.
# The model is downloaded on first enrollment or face-recognition run.
FACE_MODEL_ROOT=.models/insightface
FACE_GALLERY_PATH=.goodvision/face-gallery.json

# Optional troubleshooting override. It is deliberately not enabled by default:
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000
# Add the same variable to compose.yaml only when the target RTSP source needs it.

# Optional push delivery. Leave blank when the receiver consumes latest JSON
# or SSE from the harness directly.
RESULT_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=
