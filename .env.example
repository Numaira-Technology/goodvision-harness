# On 14.198.55.6, Docker resolves this name to the Linux host through
# compose.yaml's host-gateway mapping.
RTSP_URL=rtsp://host.docker.internal:8554/live/livestream

OPENROUTER_API_KEY=
HARNESS_DRY_RUN=false
HARNESS_SOURCE_ID=external-camera
HARNESS_BIND_ADDRESS=127.0.0.1
HARNESS_PORT=8080
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000

# Optional push delivery. Leave blank when the receiver consumes latest JSON
# or SSE from the harness directly.
RESULT_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=
