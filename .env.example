# Robot LAN WHEP source. Settings saved in the deployment console take precedence.
HARNESS_STREAM_URL=webrtc+http://192.168.20.199:1985/rtc/v1/whep/?app=live&stream=livestream

# Deprecated compatibility fallback for existing RTSP deployments.
RTSP_URL=

MODEL_API_KEY=
HARNESS_DRY_RUN=false
HARNESS_AUTOSTART=true
HARNESS_SOURCE_ID=external-camera
HARNESS_BIND_ADDRESS=127.0.0.1
HARNESS_PORT=8080

# Optional local face-analysis storage overrides. Keep both directories writable.
# This non-commercial demo config allows model download. Disable
# face.allow_model_download for any use not covered by the model license.
FACE_MODEL_ROOT=.models/face
FACE_GALLERY_PATH=.goodvision/face-gallery.json

# Optional legacy RTSP fallback/troubleshooting setting; WHEP does not use it:
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000
# Set a different value only when an RTSP source requires it.

# Optional push delivery. Leave blank when the receiver consumes latest JSON
# or SSE from the harness directly.
RESULT_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=
