# Keep 127.0.0.1 when using an SSH tunnel or a reverse proxy running directly
# on the Docker host.
# Use 0.0.0.0 only on a protected management network.
# Bind on the protected robot LAN for direct access from 192.168.20.0/24.
HARNESS_BIND_ADDRESS=0.0.0.0
HARNESS_PORT=8080
HARNESS_SOURCE_ID=external-camera

# Optional inference route and overrides; leave empty to use configured defaults.
INFERENCE_PROVIDER=
INFERENCE_MODEL=
INFERENCE_ENDPOINT=
# Credentials can be saved for the selected route in the deployment console.
# For environment-managed credentials, use this ignored file on the server.
INFERENCE_API_KEY=
AICLUB_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# The base delivery image is CPU-only. The face-GPU delivery overlay fixes this
# to CUDAExecutionProvider after its real model smoke test succeeds.
FACE_PROVIDER=CPUExecutionProvider
FACE_LIVE_SCHEDULER=auto

# Optional separately delivered Paddle rich-label worker.
RICH_LABEL_ENABLED=false
RICH_LABEL_ENDPOINT=http://rich-label-worker:8091/v1/labels
# compose.rich-gpu.delivery.yaml reserves one NVIDIA GPU as gpu:0.
RICH_GPU_DETECTOR_MODEL=PP-YOLOE_plus-L
RICH_ATTRIBUTE_MODEL=PP-LCNet_x1_0_pedestrian_attribute
RICH_DETECTION_THRESHOLD=0.45
RICH_TRACK_VISIBLE_IDLE_FRAMES=1

# Optional video-source override. The image defaults to the robot LAN WHEP source:
# HARNESS_STREAM_URL=webrtc+http://192.168.20.199:1985/rtc/v1/whep/?app=live&stream=livestream

# Optional JSON push output. Stream URL, run mode, and autostart may be saved
# from the deployment console and take precedence over environment values.
RESULT_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=

# Optional background tracking and evidence overrides.
PERSON_TRACKING_ENABLED=true
# EVENT_EVIDENCE_DIRECTORY=/data/event-evidence
# EVENT_FFMPEG_PATH=ffmpeg
